# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration: Cloudflare D1 (Serverless SQLite at the Edge)
# In production on Cloudflare Pages/Workers, D1 is automatically bound as `DB` via wrangler.jsonc / wrangler.toml.
# In local development, the app automatically persists to local SQLite (data/d1_local.sqlite) with 0 setup.
CLOUDFLARE_D1_DATABASE_NAME="nextgen_learn_d1"
# CLOUDFLARE_D1_DATABASE_ID: Provided by `npx wrangler d1 create nextgen_learn_d1`
CLOUDFLARE_D1_DATABASE_ID=""

# Razorpay Payment Gateway Credentials
# Find these in your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Cloudflare Stream Credentials
# Find Account ID and API Token (with Stream Read/Write permissions) in Cloudflare Dashboard
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_STREAM_TOKEN="your_cloudflare_stream_api_token"
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN="customer-subdomain.cloudflarestream.com"
CLOUDFLARE_STREAM_PEM_KEY_ID="your_stream_signing_key_id"
CLOUDFLARE_STREAM_PEM_JWK="your_stream_jwk_private_key"

# Authentication & Session Secrets
JWT_SECRET="your_secure_super_secret_jwt_key_at_least_32_characters"
SESSION_SECRET="your_secure_super_secret_session_key"

# Application Settings
PORT="3000"
NODE_ENV="development"
# In development, allows test mock payment verification if real Razorpay keys are not yet provided
ALLOW_TEST_PAYMENTS="true"

# Initial Default Administrator (seeded on startup if not present)
ADMIN_EMAIL="admin@nextgenlearn.com"
ADMIN_PASSWORD="AdminSecure2026!"

